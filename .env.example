# Database
DB_URL=jdbc:mysql://localhost:3306/doiquadi
DB_USERNAME=root
DB_PASSWORD=

# S3-compatible image storage (Cloudflare R2, AWS S3, MinIO)
STORAGE_ENABLED=false
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=localfood-images
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://images.example.com
STORAGE_PATH_STYLE=true
STORAGE_PRESIGN_SECONDS=300
STORAGE_MAX_FILE_SIZE=10485760
