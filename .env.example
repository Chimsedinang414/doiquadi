# Database
DB_URL=jdbc:mysql://localhost:3306/doiquadi
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=validate
SQL_INIT_MODE=always

# Authentication (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_ISSUER=localfood-api
JWT_AUDIENCE=localfood-web
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OAuth2/OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Base64-encoded PKCS#8 contents of the Apple .p8 P-256 private key.
APPLE_PRIVATE_KEY=
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth2/callback
OAUTH2_LINK_INTENT_TTL=PT5M
# Apple uses form_post; production OAuth cookies therefore require Secure + SameSite=None.
OAUTH2_COOKIE_SECURE=true

# Password reset email (SMTP)
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_URI=http://localhost:3000/reset-password
PASSWORD_RESET_MAIL_FROM=no-reply@example.com
PASSWORD_RESET_TOKEN_TTL=PT15M
PASSWORD_RESET_RESEND_COOLDOWN=PT1M
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# S3-compatible image storage (Cloudflare R2, AWS S3, MinIO)
STORAGE_ENABLED=false
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=localfood-images
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://images.example.com
STORAGE_PATH_STYLE=true
STORAGE_PRESIGN_SECONDS=300
STORAGE_MAX_FILE_SIZE=10485760
