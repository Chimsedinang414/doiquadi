# Same-origin production deployments can keep the default /api value.
VITE_API_BASE_URL=/api
# Defaults to <VITE_API_BASE_URL>/ws. Set explicitly only when WebSocket uses
# a different public endpoint.
VITE_WS_BASE_URL=/api/ws
# In local development, start OAuth directly on the backend so the state cookie
# is stored on the same host that receives the provider callback.
VITE_OAUTH_BASE_URL=http://localhost:8080/api
